{
  "include": ["src", "vite.config.ts", "drizzle.config.ts"],
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"],
      "@excalidraw/math": ["./node_modules/@excalidraw/excalidraw/dist/types/math/index.d.ts"],
      "@excalidraw/utils": ["./node_modules/@excalidraw/excalidraw/dist/types/utils/index.d.ts"],
      "@excalidraw/utils/*": ["./node_modules/@excalidraw/excalidraw/dist/types/utils/*"]
    }
  }
}
