# Copy to .env and fill in from the Supabase dashboard of the DoIT project.

# Client-safe: VITE_ variables are bundled into the browser on purpose.
# Row-level security is what protects the data, not these keys.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# SECRET, used only by drizzle-kit to run migrations. Never commit it.
# Supabase → Connect → "Session pooler" connection string.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
