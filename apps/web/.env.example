# Copy to .env and fill in from the Supabase dashboard of the DoIT project,
# or from `npx supabase status` when running Supabase locally (see the README,
# "Run it on your own network").

# Client-safe: VITE_ variables are bundled into the browser on purpose.
# Row-level security is what protects the data, not these keys.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional. OAuth buttons on the sign-in page, as a comma list: github, google.
# Empty or unset shows none. Only list a provider after turning it on in
# Supabase → Authentication → Sign In / Providers. Its OAuth app (a GitHub
# OAuth App, a Google OAuth client) needs the callback URL
# https://<project-ref>.supabase.co/auth/v1/callback.
VITE_AUTH_PROVIDERS=

# Optional. A self-hosted draw.io for diagrams, e.g. http://localhost:8080
# (docker run -p 8080:8080 jgraph/drawio). Unset uses embed.diagrams.net.
VITE_DRAWIO_URL=

# SECRET, used only by drizzle-kit to run migrations. Never commit it.
# Supabase → Connect → "Session pooler" connection string.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
